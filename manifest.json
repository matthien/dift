{
  "manifest_version": 3,
  "name": "dift",
  "version": "0.4.1",
  "description": "Highlight a word, press a shortcut, and see its definition right next to it.",

  "browser_specific_settings": {
    "gecko": {
      "id": "dift@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://en.wiktionary.org/*", "https://api.dictionaryapi.dev/*"],

  "commands": {
    "define-selection": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Define the highlighted word"
    }
  }
}
